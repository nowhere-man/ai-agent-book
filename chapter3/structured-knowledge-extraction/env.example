# Provider: openai (default) or dashscope/qwen/bailian
LLM_PROVIDER=openai

# 复制为 .env 后填入你的 OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Alibaba Cloud Model Studio / Bailian (Qwen)
# OPENAI_API_KEY=your-dashscope-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：覆盖默认模型（默认 gpt-5.6-luna）
# OPENAI_MODEL=gpt-5.6-luna

# OpenRouter 通用回退（可选）：若未设置 OPENAI_API_KEY 但设置了 OPENAI_API_KEY，
# 则聊天 LLM 会自动路由到 OpenRouter（gpt-5.6-luna -> openai/gpt-5.6-luna；
# 可用 OPENAI_MODEL 覆盖）。
# OPENAI_MODEL=openai/gpt-5.6-luna
