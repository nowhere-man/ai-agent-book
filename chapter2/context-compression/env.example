# LLM provider: kimi (default), dashscope/qwen/bailian, or openrouter
LLM_PROVIDER=kimi

# Kimi API Configuration
OPENAI_API_KEY=your-openai-api-key

# Alibaba Cloud Model Studio / Bailian (Qwen)
# OPENAI_API_KEY=your_dashscope_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# 通用回退：未设置 OPENAI_API_KEY 时，若配置了 OPENAI_API_KEY，则自动改走
# OpenRouter（kimi-* 会映射为 moonshotai/kimi-k2）。
# OPENAI_API_KEY=your-openrouter-api-key

# Search API Configuration (using Serper API - free tier available)
SERPER_API_KEY=your_serper_api_key_here

# Model Configuration
MODEL_NAME=kimi-k3
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=8192

# Agent Configuration
MAX_ITERATIONS=15
ENABLE_VERBOSE=false

# Compression Configuration
MAX_WEBPAGE_LENGTH=50000
SUMMARY_MAX_TOKENS=500
